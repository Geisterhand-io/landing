---
// Quick Start section with installation code blocks
---

<section id="quickstart" class="py-24 px-4 bg-bg-secondary/50">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-heading">
      Quick <span class="gradient-text">Start</span>
    </h2>
    <p class="section-subheading">
      Get up and running in under a minute.
    </p>

    <div class="space-y-8">
      <!-- Step 1: Install the App -->
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-full bg-accent-blue/20 text-accent-blue flex items-center justify-center text-sm font-bold">1</span>
          <h3 class="text-lg font-semibold text-text-primary">Install Geisterhand.app</h3>
        </div>
        <p class="text-text-secondary text-sm mb-4">
          Download from GitHub releases or install via Homebrew:
        </p>
        <div class="code-block">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-text-secondary">Terminal</span>
            <button class="text-xs text-text-secondary hover:text-accent-blue transition-colors copy-btn" data-copy="brew install --cask geisterhand-io/tap/geisterhand">
              Copy
            </button>
          </div>
          <code class="text-sm">
            <span class="text-green-400">brew</span> install --cask geisterhand-io/tap/geisterhand
          </code>
        </div>
        <p class="text-text-secondary text-xs mt-3">
          Or <a href="https://github.com/Geisterhand-io/macos/releases/latest" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">download the DMG</a> directly from GitHub releases.
        </p>
      </div>

      <!-- Step 2: Grant Permissions -->
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-full bg-accent-blue/20 text-accent-blue flex items-center justify-center text-sm font-bold">2</span>
          <h3 class="text-lg font-semibold text-text-primary">Grant Permissions</h3>
        </div>
        <p class="text-text-secondary text-sm mb-4">
          Launch the app and grant these permissions when prompted:
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3 p-4 bg-bg-primary rounded-lg border border-white/5">
            <svg class="w-5 h-5 text-accent-blue flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="4"/>
              <line x1="21.17" y1="8" x2="12" y2="8"/>
              <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
              <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
            </svg>
            <div>
              <div class="font-medium text-text-primary text-sm">Accessibility</div>
              <div class="text-xs text-text-secondary">For keyboard and mouse control</div>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 bg-bg-primary rounded-lg border border-white/5">
            <svg class="w-5 h-5 text-accent-blue flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <div>
              <div class="font-medium text-text-primary text-sm">Screen Recording</div>
              <div class="text-xs text-text-secondary">For screenshot capture</div>
            </div>
          </div>
        </div>
        <p class="text-text-secondary text-xs mt-3">
          The menu bar icon turns green when all permissions are granted and the server is running.
        </p>
      </div>

      <!-- Step 3: Enable Claude Integration -->
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-full bg-accent-blue/20 text-accent-blue flex items-center justify-center text-sm font-bold">3</span>
          <h3 class="text-lg font-semibold text-text-primary">Enable Claude Integration</h3>
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 mb-4 border-b border-white/10 pb-2">
          <button class="integration-tab active px-3 py-1.5 text-sm rounded-md transition-colors" data-tab="claude-code">
            Claude Code
          </button>
          <button class="integration-tab px-3 py-1.5 text-sm rounded-md transition-colors" data-tab="claude-desktop">
            Claude Desktop
          </button>
        </div>

        <!-- Claude Code Tab -->
        <div class="tab-content" id="claude-code">
          <p class="text-text-secondary text-sm mb-4">
            Click "Enable Claude Code Integration" in the menu bar app, or run:
          </p>
          <div class="code-block">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-text-secondary">Terminal</span>
              <button class="text-xs text-text-secondary hover:text-accent-blue transition-colors copy-btn" data-copy="claude mcp add-json geisterhand '{&quot;type&quot;:&quot;stdio&quot;,&quot;command&quot;:&quot;npx&quot;,&quot;args&quot;:[&quot;geisterhand-mcp&quot;]}' --scope user">
                Copy
              </button>
            </div>
            <code class="text-sm">
              <span class="text-green-400">claude</span> mcp add-json geisterhand \<br/>
              &nbsp;&nbsp;<span class="text-yellow-400">'&#123;"type":"stdio","command":"npx","args":["geisterhand-mcp"]&#125;'</span> \<br/>
              &nbsp;&nbsp;--scope user
            </code>
          </div>
          <p class="text-text-secondary text-xs mt-3">
            Then restart Claude Code. Requires Node.js 18+.
          </p>
        </div>

        <!-- Claude Desktop Tab -->
        <div class="tab-content hidden" id="claude-desktop">
          <p class="text-text-secondary text-sm mb-4">
            Add to your Claude Desktop config file:
          </p>
          <div class="code-block">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-text-secondary">~/Library/Application Support/Claude/claude_desktop_config.json</span>
            </div>
            <code class="text-sm">
              <span class="text-purple-400">&#123;</span><br/>
              &nbsp;&nbsp;<span class="text-accent-blue">"mcpServers"</span>: <span class="text-purple-400">&#123;</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent-blue">"geisterhand"</span>: <span class="text-purple-400">&#123;</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent-blue">"command"</span>: <span class="text-green-400">"npx"</span>,<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent-blue">"args"</span>: [<span class="text-green-400">"geisterhand-mcp"</span>]<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400">&#125;</span><br/>
              &nbsp;&nbsp;<span class="text-purple-400">&#125;</span><br/>
              <span class="text-purple-400">&#125;</span>
            </code>
          </div>
          <p class="text-text-secondary text-xs mt-3">
            Then restart Claude Desktop. Requires Node.js 18+.
          </p>
        </div>
      </div>

      <!-- Step 4: Start Testing -->
      <div class="card border-accent-blue/30">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-full bg-accent-blue text-white flex items-center justify-center text-sm font-bold">4</span>
          <h3 class="text-lg font-semibold text-text-primary">Start Automating!</h3>
        </div>
        <p class="text-text-secondary text-sm mb-4">
          Make sure Geisterhand.app is running, then try asking Claude:
        </p>
        <div class="code-block bg-accent-blue/5 border-accent-blue/20">
          <code class="text-sm text-text-primary">
            "Open Calculator, click 7, then +, then 3, then =. What's the result?"
          </code>
        </div>
        <p class="text-text-secondary text-xs mt-4">
          Claude will use the Accessibility API to find and click buttons by label, then take a screenshot to verify the result.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switching
  document.querySelectorAll('.integration-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      document.querySelectorAll('.integration-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      // Show corresponding content
      document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
      document.getElementById(tab.dataset.tab)?.classList.remove('hidden');
    });
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy;
      if (text) {
        navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = original, 2000);
      }
    });
  });
</script>

<style>
  .integration-tab {
    color: var(--text-secondary);
  }
  .integration-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }
  .integration-tab.active {
    color: var(--accent-blue);
    background: rgba(59, 130, 246, 0.1);
  }
</style>
