---
// How It Works section - 3 step process
---

<section id="how-it-works" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-heading">
      How It <span class="gradient-text">Works</span>
    </h2>
    <p class="section-subheading">
      Get started in three simple steps. No complex setup, no learning curve.
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Step 01: Install -->
      <div class="relative">
        <div class="hidden md:block absolute top-12 left-full w-full h-px bg-gradient-to-r from-white/20 to-transparent -translate-x-4 z-0"></div>
        <div class="card card-hover relative z-10">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-accent-blue/10 border border-accent-blue/20 flex items-center justify-center text-accent-blue">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </div>
            <span class="text-5xl font-bold text-white/5">01</span>
          </div>
          <h3 class="text-xl font-semibold mb-3 text-text-primary">Install Geisterhand</h3>
          <p class="text-text-secondary leading-relaxed">One command on macOS or Linux, one download on Windows. Sets up everything you need.</p>
          <div class="mt-3">
            <div class="flex gap-2 mb-2">
              <button class="platform-tab active px-2 py-1 text-xs rounded transition-colors" data-platform="macos">macOS</button>
              <button class="platform-tab px-2 py-1 text-xs rounded transition-colors" data-platform="windows">Windows</button>
              <button class="platform-tab px-2 py-1 text-xs rounded transition-colors" data-platform="linux">Linux</button>
            </div>
            <div class="platform-content" data-platform="macos">
              <div class="code-block py-2 px-3 text-sm">
                <code class="text-green-400">brew install --cask geisterhand-io/tap/geisterhand</code>
              </div>
            </div>
            <div class="platform-content hidden" data-platform="windows">
              <div class="code-block py-2 px-3 text-sm">
                <code><span class="text-green-400">Download</span> <a href="https://github.com/Geisterhand-io/windows/releases/latest" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">from GitHub Releases</a></code>
              </div>
            </div>
            <div class="platform-content hidden" data-platform="linux">
              <div class="code-block py-2 px-3 text-sm">
                <code class="text-green-400">cargo install geisterhand</code>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 02: Permissions -->
      <div class="relative">
        <div class="hidden md:block absolute top-12 left-full w-full h-px bg-gradient-to-r from-white/20 to-transparent -translate-x-4 z-0"></div>
        <div class="card card-hover relative z-10">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-accent-blue/10 border border-accent-blue/20 flex items-center justify-center text-accent-blue">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                <circle cx="12" cy="16" r="1"/>
              </svg>
            </div>
            <span class="text-5xl font-bold text-white/5">02</span>
          </div>
          <h3 class="text-xl font-semibold mb-3 text-text-primary">Grant Permissions</h3>
          <div>
            <div class="flex gap-2 mb-2">
              <button class="platform-tab active px-2 py-1 text-xs rounded transition-colors" data-platform="macos">macOS</button>
              <button class="platform-tab px-2 py-1 text-xs rounded transition-colors" data-platform="windows">Windows</button>
              <button class="platform-tab px-2 py-1 text-xs rounded transition-colors" data-platform="linux">Linux</button>
            </div>
            <div class="platform-content" data-platform="macos">
              <p class="text-text-secondary leading-relaxed">Launch the app once and grant Accessibility and Screen Recording permissions when prompted.</p>
            </div>
            <div class="platform-content hidden" data-platform="windows">
              <p class="text-text-secondary leading-relaxed">No extra permissions needed. Run as administrator only if automating elevated apps.</p>
            </div>
            <div class="platform-content hidden" data-platform="linux">
              <p class="text-text-secondary leading-relaxed">Enable AT-SPI2 accessibility and add your user to the input group for Wayland.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 03: Run -->
      <div class="relative">
        <div class="card card-hover relative z-10">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-accent-blue/10 border border-accent-blue/20 flex items-center justify-center text-accent-blue">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5"/>
                <line x1="12" y1="19" x2="20" y2="19"/>
              </svg>
            </div>
            <span class="text-5xl font-bold text-white/5">03</span>
          </div>
          <h3 class="text-xl font-semibold mb-3 text-text-primary">Run</h3>
          <p class="text-text-secondary leading-relaxed">Start automating any app. The server launches scoped to your target app and outputs connection details as JSON.</p>
          <div class="mt-3 code-block py-2 px-3 text-sm">
            <code class="text-green-400">geisterhand run YourApp</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
