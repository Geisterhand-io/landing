---
// How It Works section - 3 step process
const steps = [
  {
    number: "01",
    title: "Install Geisterhand",
    description: "Download Geisterhand.app or use Homebrew. The menu bar app runs the automation server and manages permissions for you.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" y1="15" x2="12" y2="3"/>
    </svg>`
  },
  {
    number: "02",
    title: "Grant Permissions",
    description: "Authorize Accessibility and Screen Recording permissions in macOS System Settings. Geisterhand guides you through it.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      <circle cx="12" cy="16" r="1"/>
    </svg>`
  },
  {
    number: "03",
    title: "Enable Claude Integration",
    description: "Click 'Enable Claude Code Integration' in the app menu, or run a single command. Then just describe what you want to automate.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
      <line x1="12" y1="19" x2="12" y2="22"/>
    </svg>`
  }
];
---

<section id="how-it-works" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-heading">
      How It <span class="gradient-text">Works</span>
    </h2>
    <p class="section-subheading">
      Get started in three simple steps. No complex setup, no learning curve.
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      {steps.map((step, index) => (
        <div class="relative">
          {/* Connector line */}
          {index < steps.length - 1 && (
            <div class="hidden md:block absolute top-12 left-full w-full h-px bg-gradient-to-r from-white/20 to-transparent -translate-x-4 z-0"></div>
          )}

          <div class="card card-hover relative z-10">
            <div class="flex items-start gap-4 mb-4">
              <div class="flex-shrink-0 w-16 h-16 rounded-xl bg-accent-blue/10 border border-accent-blue/20 flex items-center justify-center text-accent-blue">
                <Fragment set:html={step.icon} />
              </div>
              <span class="text-5xl font-bold text-white/5">{step.number}</span>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-text-primary">{step.title}</h3>
            <p class="text-text-secondary leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
