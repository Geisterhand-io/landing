---
// Use Cases section showing practical applications
const useCases = [
  {
    title: "QA Automation",
    description: "Automate repetitive QA tasks without writing test scripts. Let Claude explore your app and verify functionality using natural language instructions.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 11l3 3L22 4"/>
      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
    </svg>`,
    examples: ["Test form validation", "Verify button states", "Check error handling"]
  },
  {
    title: "Regression Testing",
    description: "Catch UI regressions before your users do. Geisterhand can compare screenshots and identify visual changes across builds.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
      <path d="M3 3v5h5"/>
      <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
      <path d="M16 16h5v5"/>
    </svg>`,
    examples: ["Compare before/after", "Detect layout shifts", "Verify theming"]
  },
  {
    title: "Documentation",
    description: "Generate up-to-date screenshots for your documentation automatically. Keep your docs in sync with your actual UI.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/>
      <line x1="16" y1="17" x2="8" y2="17"/>
      <polyline points="10 9 9 9 8 9"/>
    </svg>`,
    examples: ["Capture workflows", "Update tutorials", "Create release notes"]
  },
  {
    title: "Accessibility Audits",
    description: "Explore your app using only keyboard navigation and screen reader APIs. Identify accessibility issues before they ship.",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <circle cx="12" cy="12" r="4"/>
      <line x1="21.17" y1="8" x2="12" y2="8"/>
      <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
      <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
    </svg>`,
    examples: ["Test keyboard nav", "Verify labels", "Check focus order"]
  }
];
---

<section id="use-cases" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-heading">
      Use <span class="gradient-text">Cases</span>
    </h2>
    <p class="section-subheading">
      From quick smoke tests to comprehensive automation, Geisterhand adapts to your workflow.
    </p>

    <div class="grid md:grid-cols-2 gap-6">
      {useCases.map((useCase) => (
        <div class="card card-hover">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-accent-blue/20 to-purple-500/20 border border-white/10 flex items-center justify-center text-accent-blue">
              <Fragment set:html={useCase.icon} />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-semibold mb-2 text-text-primary">{useCase.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed mb-4">{useCase.description}</p>
              <div class="flex flex-wrap gap-2">
                {useCase.examples.map((example) => (
                  <span class="px-3 py-1 bg-white/5 rounded-full text-xs text-text-secondary border border-white/5">
                    {example}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <p class="text-text-secondary mb-6">Ready to automate your Mac app testing?</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#quickstart" class="btn-primary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"/>
            <line x1="12" y1="19" x2="20" y2="19"/>
          </svg>
          Get Started
        </a>
        <a href="https://github.com/Geisterhand-io/macos" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Read the Docs
        </a>
      </div>
    </div>
  </div>
</section>
