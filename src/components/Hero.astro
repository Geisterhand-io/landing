---
// Hero section with main headline and CTAs
---

<section class="relative overflow-hidden pt-20 pb-32 px-4">
  <!-- Background gradient effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-accent-blue/10 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/4 -right-1/4 w-[600px] h-[600px] bg-purple-500/10 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative max-w-6xl mx-auto">
    <!-- Logo and Navigation -->
    <nav class="flex items-center justify-between mb-20">
      <a href="/" class="flex items-center gap-3 group">
        <!-- Ghost Hand Logo SVG -->
        <svg class="w-10 h-10" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#3b82f6"/>
              <stop offset="100%" style="stop-color:#8b5cf6"/>
            </linearGradient>
          </defs>
          <path d="M16 2C9.373 2 4 7.373 4 14v12c0 1.5 1.5 2.5 2.8 1.8l1.7-1.3 2 1.5c.6.4 1.4.4 2 0l2-1.5 2 1.5c.6.4 1.4.4 2 0l2-1.5 1.7 1.3c1.3.7 2.8-.3 2.8-1.8V14c0-6.627-5.373-12-12-12z" fill="url(#logo-gradient)" opacity="0.9"/>
          <path d="M12 12v8c0 .5.4 1 1 1s1-.5 1-1v-6h1v7c0 .5.4 1 1 1s1-.5 1-1v-7h1v5c0 .5.4 1 1 1s1-.5 1-1v-5h1v3c0 .5.4 1 1 1s1-.5 1-1v-5c0-2-1.5-3-3-3h-4c-1.5 0-3 1-3 3z" fill="#f8f8f8" opacity="0.95"/>
          <circle cx="11" cy="11" r="2" fill="#0a0a0a"/>
          <circle cx="19" cy="11" r="2" fill="#0a0a0a"/>
        </svg>
        <span class="text-xl font-semibold text-text-primary group-hover:text-accent-blue transition-colors">Geisterhand</span>
      </a>

      <div class="flex items-center gap-4">
        <a href="https://github.com/Geisterhand-io" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors flex items-center gap-2">
          <!-- GitHub Icon -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </div>
    </nav>

    <!-- Hero Content -->
    <div class="text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-text-secondary mb-8">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span>Open Source App Automation for Claude</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-balance leading-tight">
        Test Any App
        <span class="gradient-text"> Like Magic</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-text-secondary mb-10 max-w-2xl mx-auto text-balance">
        The ghost hand that automates your apps on macOS, Windows, and Linux. Click buttons, type text, navigate UI elements, and capture screenshots with natural language through Claude Code or Claude Desktop.
      </p>

      <!-- Install Command with Platform Tabs -->
      <div class="max-w-lg mx-auto mb-6">
        <div class="flex gap-2 mb-3 justify-center">
          <button class="platform-tab active px-3 py-1.5 text-sm rounded-md transition-colors" data-platform="macos">
            macOS
          </button>
          <button class="platform-tab px-3 py-1.5 text-sm rounded-md transition-colors" data-platform="windows">
            Windows
          </button>
          <button class="platform-tab px-3 py-1.5 text-sm rounded-md transition-colors" data-platform="linux">
            Linux
          </button>
        </div>
        <div class="platform-content" data-platform="macos">
          <div class="code-block flex items-center justify-between gap-4 py-3">
            <code class="text-sm">
              <span class="text-green-400">brew</span> install --cask geisterhand-io/tap/geisterhand
            </code>
            <button class="text-xs text-text-secondary hover:text-accent-blue transition-colors flex-shrink-0 copy-btn" data-copy="brew install --cask geisterhand-io/tap/geisterhand">
              Copy
            </button>
          </div>
        </div>
        <div class="platform-content hidden" data-platform="windows">
          <a href="https://github.com/Geisterhand-io/windows/releases/latest" target="_blank" rel="noopener noreferrer" class="code-block flex items-center justify-between gap-4 py-3 group hover:border-accent-blue/30 block">
            <code class="text-sm">
              <span class="text-green-400">Download</span> Geisterhand for Windows
            </code>
            <span class="text-xs text-text-secondary group-hover:text-accent-blue transition-colors flex-shrink-0">
              GitHub Releases &rarr;
            </span>
          </a>
          <p class="text-xs text-text-secondary/70 mt-2">Windows code signing coming soon. You may see a SmartScreen warning on first run.</p>
        </div>
        <div class="platform-content hidden" data-platform="linux">
          <div class="code-block flex items-center justify-between gap-4 py-3">
            <code class="text-sm">
              <span class="text-green-400">cargo</span> install geisterhand
            </code>
            <button class="text-xs text-text-secondary hover:text-accent-blue transition-colors flex-shrink-0 copy-btn" data-copy="cargo install geisterhand">
              Copy
            </button>
          </div>
          <p class="text-xs text-text-secondary/70 mt-2">On Arch Linux: <code class="text-accent-blue">yay -S geisterhand</code></p>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="#quickstart" class="btn-primary w-full sm:w-auto">
          Get Started
        </a>
        <a href="https://github.com/Geisterhand-io" target="_blank" rel="noopener noreferrer" class="btn-secondary w-full sm:w-auto">
          <!-- GitHub Icon -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </div>

      <!-- Code Preview -->
      <div class="code-block text-left max-w-2xl mx-auto">
        <div class="flex items-center gap-2 mb-3 text-text-secondary text-xs">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
          <span class="ml-2">Terminal</span>
        </div>
        <code class="text-text-secondary">
          <span class="text-text-secondary">$</span> <span class="text-green-400">geisterhand run</span> <span class="text-text-primary">Calculator</span><br/>
          <span class="text-text-secondary">&#123;"port":49152,"pid":12345,"app":"Calculator","host":"127.0.0.1"&#125;</span><br/><br/>
          <span class="text-purple-400">You:</span> <span class="text-text-primary">Click 7, then +, then 3, then =. What's the result?</span><br/><br/>
          <span class="text-accent-blue">Claude:</span> <span class="text-text-primary">The result is 10. I used the accessibility API to find and press buttons by their labels, then captured a screenshot to verify.</span>
        </code>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy;
      if (text) {
        navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = original, 2000);
      }
    });
  });

  // Platform tab switching - syncs across the entire page
  function initPlatformTabs() {
    const ua = navigator.platform || navigator.userAgent;
    const isMac = /Mac|iPhone|iPad|iPod/.test(ua);
    const isLinux = /Linux/.test(ua) && !/Android/.test(navigator.userAgent);
    const defaultPlatform = isMac ? 'macos' : isLinux ? 'linux' : 'windows';

    function switchPlatform(platform) {
      document.querySelectorAll('.platform-tab').forEach(tab => {
        tab.classList.toggle('active', tab.dataset.platform === platform);
      });
      document.querySelectorAll('.platform-content').forEach(content => {
        content.classList.toggle('hidden', content.dataset.platform !== platform);
      });
    }

    // Set initial platform based on user's OS
    switchPlatform(defaultPlatform);

    // Add click handlers
    document.querySelectorAll('.platform-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        switchPlatform(tab.dataset.platform);
      });
    });
  }

  initPlatformTabs();
</script>
