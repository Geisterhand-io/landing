---
// Footer component with links, license, and credits
const currentYear = new Date().getFullYear();

const links = {
  product: [
    { name: "Features", href: "#features" },
    { name: "Quick Start", href: "#quickstart" },
    { name: "API Reference", href: "#api" },
    { name: "Use Cases", href: "#use-cases" },
  ],
  resources: [
    { name: "Testing Guide", href: "https://github.com/Geisterhand-io/macos/blob/main/TESTING_WITH_GEISTERHAND.md" },
    { name: "API Reference", href: "https://github.com/Geisterhand-io/macos/blob/main/LLM_API_GUIDE.md" },
    { name: "macOS App", href: "https://github.com/Geisterhand-io/macos" },
    { name: "Windows App", href: "https://github.com/Geisterhand-io/windows" },
    { name: "Linux App", href: "https://github.com/Geisterhand-io/linux" },
    { name: "MCP Server", href: "https://github.com/Geisterhand-io/mcp" },
    { name: "npm Package", href: "https://www.npmjs.com/package/geisterhand-mcp" },
    { name: "Releases", href: "https://github.com/Geisterhand-io/macos/releases" },
  ],
  legal: [
    { name: "MIT License", href: "https://github.com/Geisterhand-io/macos/blob/main/LICENSE" },
  ],
};
---

<footer class="py-16 px-4 border-t border-white/5">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4">
          <!-- Logo -->
          <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="footer-logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#3b82f6"/>
                <stop offset="100%" style="stop-color:#8b5cf6"/>
              </linearGradient>
            </defs>
            <path d="M16 2C9.373 2 4 7.373 4 14v12c0 1.5 1.5 2.5 2.8 1.8l1.7-1.3 2 1.5c.6.4 1.4.4 2 0l2-1.5 2 1.5c.6.4 1.4.4 2 0l2-1.5 1.7 1.3c1.3.7 2.8-.3 2.8-1.8V14c0-6.627-5.373-12-12-12z" fill="url(#footer-logo-gradient)" opacity="0.9"/>
            <path d="M12 12v8c0 .5.4 1 1 1s1-.5 1-1v-6h1v7c0 .5.4 1 1 1s1-.5 1-1v-7h1v5c0 .5.4 1 1 1s1-.5 1-1v-5h1v3c0 .5.4 1 1 1s1-.5 1-1v-5c0-2-1.5-3-3-3h-4c-1.5 0-3 1-3 3z" fill="#f8f8f8" opacity="0.95"/>
            <circle cx="11" cy="11" r="2" fill="#0a0a0a"/>
            <circle cx="19" cy="11" r="2" fill="#0a0a0a"/>
          </svg>
          <span class="text-lg font-semibold text-text-primary">Geisterhand</span>
        </a>
        <p class="text-sm text-text-secondary leading-relaxed">
          The ghost hand that automates your apps. Open source MCP server for AI-powered app testing.
        </p>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary mb-4">Product</h4>
        <ul class="space-y-2">
          {links.product.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-secondary hover:text-text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources Links -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary mb-4">Resources</h4>
        <ul class="space-y-2">
          {links.resources.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-sm text-text-secondary hover:text-text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary mb-4">Legal</h4>
        <ul class="space-y-2">
          {links.legal.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-sm text-text-secondary hover:text-text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-text-secondary">
        &copy; {currentYear} Skelpo GmbH. Released under the MIT License.
      </p>
      <div class="flex items-center gap-4">
        <!-- GitHub -->
        <a href="https://github.com/Geisterhand-io" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>

        <!-- Twitter/X -->
        <a href="https://x.com/skelpox" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Twitter">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Credits -->
    <div class="mt-8 pt-6 border-t border-white/5 text-center">
      <p class="text-xs text-text-secondary/60">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-text-secondary transition-colors">Astro</a> and <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="hover:text-text-secondary transition-colors">Tailwind CSS</a>.
        Powered by <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener noreferrer" class="hover:text-text-secondary transition-colors">Model Context Protocol</a>.
      </p>
    </div>
  </div>
</footer>
